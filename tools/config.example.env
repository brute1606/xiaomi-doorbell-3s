# Copy to config.env (never commit config.env).
# Host that the doorbell connects to for commands/OTA.
HUB_HOST=192.0.2.10
HUB_CMD_PORT=2231
HUB_OUT_PORT=2232
HUB_OTA_PORT=2233
# UART adapter on the workstation
UART_DEV=/dev/ttyUSB0
UART_BAUD=115200
# QEMU binary for the sandbox check
QEMU_BIN=qemu-system-mipsel

# --- /config/net.env on the device (read by poller.sh and ota.sh) ---
# HUB=192.0.2.10
# CMD_PORT=2231
# OUT_PORT=2232
# OTA_PORT=2233
# STATIC_IP=192.0.2.20
# STATIC_MASK=255.255.255.0
# STATIC_GW=192.0.2.1
